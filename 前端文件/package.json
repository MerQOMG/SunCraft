{
  "name": "suncraft-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "node scripts/preview.cjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build:offline": "node scripts/build-offline.mjs",
    "format": "prettier --write src tests scripts *.ts *.json",
    "format:check": "prettier --check src tests scripts *.ts *.json"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.10.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
